# ============================================================
# Environment variables — set these in Railway (Project → Variables).
# NEVER commit real values. Copy to .env for local development.
# ============================================================

# Anthropic API key (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Model for the chatbot. Prefer a fast model for high-volume customer chat.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Local dev port (Railway supplies PORT automatically in production)
PORT=3000
